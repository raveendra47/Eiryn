{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eiryn",
  "version": "0.1.0",
  "identifier": "com.eiryn.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm.cmd dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eiryn",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0d0d0f",
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https: blob:; media-src 'self' asset: http://asset.localhost https: http: blob:; connect-src 'self' https: http: ipc:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "ogg",
          "wma",
          "aac",
          "opus",
          "wv",
          "aiff",
          "dsf",
          "dff",
          "ape",
          "mpc",
          "tta",
          "mid"
        ],
        "name": "eiryn-audio",
        "description": "Audio File"
      }
    ]
  }
}